# Django core
# Use lisa.settings.production on Vercel / any public host.
DJANGO_SETTINGS_MODULE=lisa.settings.production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Optional: your custom domain, e.g. https://learn.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://learn.example.com

# Database
# Local default (no env needed): SQLite file db.sqlite3
# REQUIRED on Vercel — without Postgres, accounts vanish when /tmp SQLite resets:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# (Neon / Supabase / Vercel Postgres connection string works)

# Optional: Ollama for smarter speaking tutor replies (http://127.0.0.1:11434)
# OLLAMA_MODEL=llama3.2

# Optional: Gemini (Google AI Studio) for real AI-graded Writing feedback.
# Free key, no billing required: https://aistudio.google.com/apikey
# Missing key falls back to the word-count placeholder automatically.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Pexels API key, used only by the lesson seed commands to source
# licensed stock photos for photo-description items (Listening Part 1,
# Writing photo-sentence tasks). Free, no billing required:
# https://www.pexels.com/api/
# Missing key leaves image_url/image_credit blank on those lessons instead
# of fabricating a placeholder image.
# PEXELS_API_KEY=
